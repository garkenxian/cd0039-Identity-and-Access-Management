# Auth0 Configuration
# Copy this file to .env and fill in your Auth0 values
# NEVER commit .env with real credentials

# Your Auth0 domain (e.g., coffee-shop-dev.auth0.com)
AUTH0_DOMAIN=

# Your Auth0 API audience identifier (e.g., coffee-shop-api)
# Must match what you set in Auth0 API settings
API_AUDIENCE=

# JWT signing algorithms (default: RS256)
# Only RS256 is supported for this project (Auth0 standard)
ALGORITHMS=RS256

# Frontend Auth0 Configuration (for environment.ts)
# Auth0 domain for frontend (same as AUTH0_DOMAIN)
REACT_APP_AUTH0_DOMAIN=

# Auth0 SPA application Client ID
REACT_APP_AUTH0_CLIENT_ID=

# Auth0 API audience for frontend (same as API_AUDIENCE)
REACT_APP_AUTH0_AUDIENCE=

# Backend URL for frontend API calls
REACT_APP_API_SERVER_URL=http://127.0.0.1:5000

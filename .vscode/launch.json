    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Backend (Debug)",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "pythonPath": "${workspaceFolder}/Project/03_coffee_shop_full_stack/starter_code/backend/venv/Scripts/python.exe",
            "args": [
                "run",
                "--reload",
                "--debugger"
            ],
            "jinja": true,
            "justMyCode": true,
            "env": {
                "FLASK_APP": "src/api.py",
                "FLASK_ENV": "development",
                "PYTHONUNBUFFERED": "1"
            },
            "cwd": "${workspaceFolder}/Project/03_coffee_shop_full_stack/starter_code/backend",
            "console": "integratedTerminal",
            "preLaunchTask": "install-backend"
        }
    ]
}